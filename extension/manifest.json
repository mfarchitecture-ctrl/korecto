{
  "manifest_version": 3,
  "name": "Korecto — sélection",
  "version": "0.1.0",
  "description": "Ouvrir le texte sélectionné dans Korecto, sans correction automatique.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Korecto — état de la liaison",
    "default_popup": "status.html"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}